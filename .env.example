# MeshChile · Observer MSC — configuración de meshcore-packet-capture
#
# Copia este archivo como .env.local DENTRO de la carpeta de meshcore-packet-capture
# y reemplaza los CAMBIA_*. (El install.sh lo hace por ti.)
#   cp .env.example /ruta/a/meshcore-packet-capture/.env.local
#   chmod 600 .env.local
#
# Los valores del broker MeshChile ya están puestos. NO se pone ninguna llave: si tu
# Companion exporta la llave por USB (lo normal hoy), packet-capture firma on-device.

# === Conexión a tu nodo MeshCore ===========================================
# serial (USB) | ble | tcp
PACKETCAPTURE_CONNECTION_TYPE=serial
# Ruta ESTABLE del puerto. Búscala con:  ls -l /dev/serial/by-id/
# (no uses /dev/ttyACM0 directo: cambia de número al reconectar)
PACKETCAPTURE_SERIAL_PORTS=CAMBIA_TU_PUERTO
PACKETCAPTURE_SERIAL_BAUD_RATE=115200
# Para BLE en vez de USB: CONNECTION_TYPE=ble y configura el dispositivo (ver
# README de meshcore-packet-capture).

# === Tu zona (código IATA) =================================================
# Ver tabla en el README. Santiago/RM = SCL.
PACKETCAPTURE_IATA=CAMBIA_IATA
PACKETCAPTURE_TOPIC_PACKETS=meshcore/{IATA}/{PUBLIC_KEY}/packets
PACKETCAPTURE_TOPIC_STATUS=meshcore/{IATA}/{PUBLIC_KEY}/status

# === Broker nacional MeshChile (no tocar) ==================================
PACKETCAPTURE_MQTT1_ENABLED=true
PACKETCAPTURE_MQTT1_SERVER=mqtt-msc.meshchile.cl
PACKETCAPTURE_MQTT1_PORT=443
PACKETCAPTURE_MQTT1_TRANSPORT=websockets
PACKETCAPTURE_MQTT1_USE_TLS=true
PACKETCAPTURE_MQTT1_TLS_VERIFY=true
PACKETCAPTURE_MQTT1_QOS=0
PACKETCAPTURE_MQTT1_RETAIN=true
# Auth por token JWT firmado on-device. Username v1_<PUBKEY> y password=token los
# arma el programa solo; deja USERNAME/PASSWORD sin setear.
PACKETCAPTURE_MQTT1_USE_AUTH_TOKEN=true
PACKETCAPTURE_MQTT1_TOKEN_AUDIENCE=mqtt-msc.meshchile.cl

# === Opcional ===============================================================
# Si tu firmware NO exporta la llave, genera una identidad de software (mc-keygen)
# y ponla acá (128 hex). Ver README.
# PACKETCAPTURE_PRIVATE_KEY=
# Correlación de dueño en analytics (no es la identidad de firma):
# PACKETCAPTURE_OWNER_PUBLIC_KEY=
